model BaseUser {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  email_verifird Boolean  @default(false)
  is_blocked     Boolean  @default(false)
  profile_id     Int?      @unique
  profile        Profile?  @relation(fields: [profile_id], references: [id])
  role           UserRole @default(USER)
  fcmToken       String?  @map("fcm_token")

  // Stripe seller onboarding
  stripe_account_id          String?
  stripe_onboarding_complete Boolean @default(false)
  language_preference        LanguagePreference @default(EN)
  currency_preference        CurrencyPreference @default(USD)
  seller_tier                SellerTier @default(BASIC_SELLER)

  products        Product[]
  wishlist_items  WishlistItem[]
  reviews         ProductReview[]
  buyer_chat      ChatRoom[] @relation("BuyerChatRoom")
  seller_chat     ChatRoom[] @relation("SellerChatRoom")
  cart            Cart?
  notifications   Notification[]
  device_tokens   UserDeviceToken[]
  push_logs       PushNotificationLog[]
  messages        ChatMessage[]
  recently_viewed RecentlyView[]
  buyer_orders    Order[]    @relation("BuyerOrders")
  seller_orders   Order[]    @relation("SellerOrders")
  payment_transactions PaymentTransaction[]
  return_requests ReturnRequest[]
  delivery_option SellerDeliveryOption?
  addresses       UserAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id         Int       @id @default(autoincrement())
  avatar_url String?
  full_name  String
  phone      String
  country    String?
  userId     Int       @unique
  user       BaseUser?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("profiles")
}

model OtpVerification {
  id        Int    @id @default(autoincrement())
  requestId String @unique

  userId  Int?
  purpose OtpPurpose

  otp String

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  verified Boolean @default(false)
  used     Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  RESET_PASSWORD
}

enum UserRole {
  USER
  ADMIN
}

enum SellerTier {
  BASIC_SELLER
  STANDARD_SELLER
  PREMIUM_SELLER
}

enum LanguagePreference {
  EN
  BG
}

enum CurrencyPreference {
  USD
  EUR
  AED
  GBP
}
