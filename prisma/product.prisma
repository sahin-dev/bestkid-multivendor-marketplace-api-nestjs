model Product {
  id                  Int           @id @default(autoincrement())
  name                String
  description         String?
  brand               String?
  grade               String?
  original_price      Float
  discounted_price    Float?
  discount_percentage Float?
  image_urls          String[]
  categoryId          Int
  subCategoryId       Int
  userId              Int
  condition           Condition     @default(NEW)
  status              ProductStatus @default(INACTIVE)
  views               Int           @default(0)

  reviews             ProductReview[]
  order_items         OrderItem[]
  wishlist_items      WishlistItem[]
  total_reviews       Int             @default(0)
  average_rating      Float?          @default(0)
  cart_listed         CartItem[]
  recently_viewed     RecentlyView[]
  is_authenticated    Boolean              @default(false)
  authentication_status AuthenticationStatus @default(NOT_SUBMITTED)
  approved_at         DateTime?
  rejected_at         DateTime?
  sold_at             DateTime?
  authentication_requests ProductAuthenticationRequest[]
  subCategory         SubCategory     @relation(fields: [subCategoryId], references: [id])
  category            Category        @relation(fields: [categoryId], references: [id])
  user                BaseUser        @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductAuthenticationRequest {
  id              Int       @id @default(autoincrement())
  productId       Int
  provider        String    @default("LEGITGRAILS")
  externalOrderId String?
  status          String
  verdict         String?
  certificateUrl  String?
  reportUrl       String?
  image_urls      String[]
  submittedAt     DateTime?
  completedAt     DateTime?
  lastError        String?
  rawRequest       Json?
  rawResponse      Json?
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([externalOrderId])
  @@map("product_authentication_requests")
}

model ProductReview {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  orderItemId Int?   @unique
  rating    Int
  review    String?

  product   Product    @relation(fields: [productId], references: [id])
  user      BaseUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  SOLD
}

enum AuthenticationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  NOT_VERIFIED
}
