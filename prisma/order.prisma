model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  sellerId    Int
  status      OrderStatus @default(PENDING)
  total       Float       @default(0)

  cancelled_at         DateTime?
  cancelled_by_user_id Int?
  cancelled_by_actor   OrderCancellationActor?
  cancellation_reason  String?
  confirmed_at         DateTime?
  processing_at        DateTime?
  shipped_at           DateTime?
  delivered_at         DateTime?

  // Delivery info snapshot at order time
  delivery_partner  String?
  delivery_cost     Float   @default(0)
  delivery_days_min Int?
  delivery_days_max Int?

  shippingAddress String?
  city            String?
  postalCode      String?
  country         String?
  stripe_checkout_session_id String? @unique

  // Snapshot at payment, so a later change of seller tier or fee cannot rewrite past earnings.
  // seller_net_amount is what the seller keeps in USD, and goes down when a return is refunded.
  platform_fee_percent Float?
  seller_net_amount    Float?
  // Financed orders are paid out by an admin once the bank has settled. Card payments transfer
  // to the seller at checkout and never use these.
  seller_payout_at        DateTime?
  seller_payout_reference String?

  items    OrderItem[]
  payment_transactions PaymentTransaction[]
  user     BaseUser    @relation("BuyerOrders",  fields: [userId],   references: [id])
  seller   BaseUser    @relation("SellerOrders", fields: [sellerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
  @@index([userId])
  @@index([sellerId])
  @@index([status])
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  price     Float

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  returnRequests ReturnRequest[]
  review         ProductReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderCancellationActor {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}
