NODE_ENV=production
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bestkid
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bestkid?schema=public

JWT_SECRET=replace-this-with-a-strong-secret
JWT_EXPIRES_IN=7d

SWAGGER_SERVER_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_MAIL=hello@example.com
MAILER_PASSWORD=your-password
MAILER_SERVICE=Gmail

STRIPE_KEY=your_stripe_key
STRIPE_WEBHOOK=your_stripe_webhook_secret
STRIPE_PLATFORM_FEE_PERCENT=10

LEGITGRAILS_ENABLED=false
LEGITGRAILS_BASE_URL=https://api.legitgrails.com/v1/integrations
LEGITGRAILS_API_KEY=your_legitgrails_api_key
LEGITGRAILS_TEST_MODE=true
LEGITGRAILS_WEBHOOK_SIGNING_SECRET=replace-me
LEGITGRAILS_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
LEGITGRAILS_TIMEOUT_MS=15000

BASE_PATH=http://localhost:3000
