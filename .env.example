# Copy to .env (on the server: $DEPLOY_PATH/shared/.env) and fill in real values.
# With NODE_ENV=production the API refuses to start if a required value is missing or unsafe.

# --- Runtime ---
NODE_ENV=production
PORT=5050
# Number of reverse proxies in front of the API. Rate limiting depends on this being right.
TRUST_PROXY_HOPS=1
# The public URL of the website, used for Stripe onboarding fallbacks
APP_URL=https://bestkid.eu
# The public URL of this API, used for the TBI status webhook and absolute image links
API_PUBLIC_URL=https://api.bestkid.eu
# Comma separated, exact origins. Include the website (with and without www) and the dashboard.
CORS_ORIGINS=https://bestkid.eu,https://www.bestkid.eu,https://YOUR-DASHBOARD-DOMAIN
# Serve Swagger at /docs in production
ENABLE_SWAGGER=false

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bestkid?schema=public

# --- Auth ---
# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email ---
MAILER_HOST=
MAILER_PORT=587
MAILER_MAIL=
MAILER_PASSWORD=
MAILER_SERVICE=

# --- Stripe ---
STRIPE_KEY=
STRIPE_WEBHOOK=
# Platform commission per seller tier, as a percentage. Each defaults to 10.
STRIPE_BASIC_SELLER_FEE_PERCENT=10
STRIPE_STANDARD_SELLER_FEE_PERCENT=10
STRIPE_PREMIUM_SELLER_FEE_PERCENT=10

# --- TBI Credit ---
TBI_ENABLED=false
TBI_COUNTRY=BG
# Production endpoint from TBI. Leaving this unset uses their test environment.
TBI_BASE_URL=
TBI_RESELLER_CODE=
TBI_RESELLER_KEY=
TBI_ENCRYPTION_KEY=
TBI_CURRENCY=EUR
TBI_TIMEOUT_MS=15000
# Optional. Status webhooks are confirmed with TBI's API either way.
TBI_WEBHOOK_SECRET=
# How long items stay held while the bank decides. Default: 48 hours.
TBI_RESERVATION_MINUTES=2880

# --- LegitGrails ---
LEGITGRAILS_ENABLED=false
LEGITGRAILS_BASE_URL=https://api.legitgrails.com/v1/integrations
LEGITGRAILS_API_KEY=
# Must be false in production: test keys verify items with mock outcomes.
LEGITGRAILS_TEST_MODE=false
LEGITGRAILS_WEBHOOK_SIGNING_SECRET=
LEGITGRAILS_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
LEGITGRAILS_TIMEOUT_MS=15000

# --- Firebase push (optional) ---
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Monitoring (optional) ---
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Currency (optional) ---
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest
EXCHANGE_RATE_CACHE_TTL_MS=3600000

# --- Admin seed: only read by `pnpm seed:admin` ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
